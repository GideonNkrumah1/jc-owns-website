# Copy this file to `.env` for local development, or enter these as
# Environment Variables in your hosting provider's dashboard (e.g. Vercel)
# for production. Never commit a real `.env` file to git.

# --- Database (required) ---------------------------------------------------
# A PostgreSQL connection string. See DEPLOYMENT.md for how to get one for
# free from Neon, Supabase, or Vercel Postgres.
DATABASE_URL="postgresql://user:password@host:5432/database_name"

# --- Admin login (required) -------------------------------------------------
# NextAuth needs a full site URL and a random secret string.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="https://www.jc-owns.com"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Used ONLY the very first time you run the seed script, to create the first
# admin account. After that, change your password from inside the admin
# dashboard (Settings > Change Password) — editing these values afterwards
# has no effect on an existing account.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# --- Business contact details (required) ------------------------------------
# Used by the seed script to fill in Site Settings the first time. You can
# change all of this later from the admin dashboard without touching code.
WHATSAPP_NUMBER="233559038376"
PHONE_DISPLAY="055 903 8376"

# --- Site URL (required) ----------------------------------------------------
# Your real, public domain. Used for SEO tags, the sitemap, and canonical
# links. Must NOT have a trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.jc-owns.com"

# --- Analytics (optional) ---------------------------------------------------
# A Google Analytics 4 Measurement ID (starts with "G-"). Leave blank to
# disable GA4 — the admin dashboard will still show enquiry and order counts
# either way, since those are stored directly in your database.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Image uploads (optional) -----------------------------------------------
# Lets the admin dashboard upload product photos directly instead of only
# pasting image URLs. See DEPLOYMENT.md for how to enable Vercel Blob.
# Leave blank to disable — you can still add photos by pasting a URL.
BLOB_READ_WRITE_TOKEN=""
